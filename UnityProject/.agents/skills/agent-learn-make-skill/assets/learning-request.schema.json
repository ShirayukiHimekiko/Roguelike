{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["mode", "learning_goal", "scope", "materials", "constraints", "acceptance", "output_root"],
  "properties": {
    "mode": {"enum": ["learn", "update", "apply"]},
    "learning_depth": {"enum": ["systematic", "targeted"], "description": "Daily learning defaults to systematic breadth and depth; targeted requires an actual bounded or urgent request. This declaration does not prove scope coverage."},
    "learning_goal": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "materials": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["location", "kind", "purpose"], "properties": {"location": {"type": "string", "minLength": 1}, "kind": {"enum": ["source", "project", "documentation", "requirement", "paper", "creative_case", "feedback", "skill"]}, "purpose": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "output_root": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
