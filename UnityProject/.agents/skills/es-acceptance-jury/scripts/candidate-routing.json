  "symptoms": {
    "spawn-appear": {
      "title": "对象凭空出现／突然冒出（含刷怪、传送、池复用）",
      "blocks": [
        "rules"
      ],
      "templates": [
        "U5",
        "U9"
      ],
      "progress": [
        "F-P0-03"
      ],
      "architecture": [
        "A-P0-01",
        "A-P0-03",
        "A-P0-04"
      ],
      "staticChain": [
        "生成点与实际 Spawner/工厂调用者：谁创建、什么条件触发、当前实际读到哪个调用点",
        "所属区域/路与坐标域、父变换、高度、占用是否越界：实际配置值与合法边界对照",
        "池的取得→重绑定→归还顺序：旧实例是否被写到新位置，回池后身份是否仍被旧持有者使用",
        "取景链：相机 rig 与跟随目标/延迟、画幅与安全区、近远裁剪面与 Layer/Culling Mask、世界↔屏幕换算、相机切换混合时刻——位置合法而取景错误同样会让对象\"出现在屏幕中间\""
      ],
      "legalContrast": [
        "规则允许的钻地/固定生成点刷出",
        "批准传送与设计内跳切"
      ],
      "cannotConclude": "静图或单帧不能签权威坐标与生成合法性；完整静态链可确证对应违约，缺链只限未证命题，正常速度过程用于连续体验。生成与取景原因可共存，分别裁定。"
    },
